{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-value-reflection:analysis:schemas:edit",
  "title": "Canonical edit record (analysis/data/canonical/edits.jsonl)",
  "description": "One record per raw record in the 7 RELIABLE_RUNS files (2,740 total): applied edits, the 2 abstentions, and the 158 generation-error records that occupy round slots. Context fields are extracted from the replayed document state as it was when the model made the edit. apply_status extends the brief's enum with no_change (abstentions) and generation_error (API/parse failures with no edit text), documented in reports/00_inventory.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edit_id", "run_id", "model", "model_id", "provider", "document_id",
    "document_type", "document_owner", "document_provider", "condition",
    "condition_name", "round", "total_rounds_metadata", "seed", "timestamp",
    "change_description", "find_text", "replace_text", "replace_text_sanitized",
    "is_abstention", "apply_status", "match_strategy", "retried", "error",
    "generation_input_tokens", "generation_output_tokens", "section_heading",
    "context_before", "context_after", "context_missing_reason", "v1_code"
  ],
  "properties": {
    "edit_id": {
      "type": "string",
      "description": "v1 pipe id: {run_stem}|{condition_id}|{model_display}|{document_id}|{doc_type}|{round}. Identical to the v1 coded file's id field; unique corpus-wide.",
      "pattern": "^run_[0-9]{8}_[0-9]{6}\\|[a-z_]+\\|.+\\|[a-z_]+\\|(constitution|system_prompt)\\|[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "enum": [
        "run_20260403_014905", "run_20260424_165115", "run_20260429_175345",
        "run_20260507_212254", "run_20260513_193319", "run_20260516_210913",
        "run_20260518_171402"
      ]
    },
    "model": {
      "type": "string",
      "enum": [
        "Claude Haiku 4.5", "Claude Opus 4.7", "Claude Sonnet 4.6",
        "GPT-5.4", "GPT-5.4 Mini", "GPT-5.5",
        "Gemini 3 Flash", "Gemini 3.1 Pro", "Grok 4.2", "Grok 4.3"
      ]
    },
    "model_id": {
      "type": "string",
      "enum": [
        "anthropic/claude-haiku-4.5", "anthropic/claude-opus-4.7",
        "anthropic/claude-sonnet-4.6", "openai/gpt-5.4", "openai/gpt-5.4-mini",
        "openai/gpt-5.5", "google/gemini-3-flash-preview",
        "google/gemini-3.1-pro-preview", "x-ai/grok-4.20-beta", "x-ai/grok-4.3"
      ]
    },
    "provider": { "type": "string", "enum": ["anthropic", "openai", "google", "x-ai"] },
    "document_id": {
      "type": "string",
      "enum": [
        "claude_constitution", "openai_model_spec", "openai_model_spec_no_csam",
        "gemini_constitution", "opus_system_prompt", "gpt_system_prompt",
        "gemini_system_prompt", "grok_system_prompt"
      ]
    },
    "document_type": { "type": "string", "enum": ["constitution", "system_prompt"] },
    "document_owner": { "type": "string", "enum": ["Anthropic", "OpenAI", "Google", "xAI"] },
    "document_provider": { "type": "string", "enum": ["anthropic", "openai", "google", "xai"] },
    "condition": {
      "type": "string",
      "enum": [
        "baseline", "you_framing", "allow_no_edit", "no_constitution_prepend",
        "implementation_note", "cross_edit"
      ]
    },
    "condition_name": { "type": "string" },
    "round": { "type": "integer", "minimum": 1, "maximum": 20 },
    "total_rounds_metadata": {
      "type": "integer",
      "description": "Raw total_rounds field from the run record. UNRELIABLE metadata: 138 records carry 3 here despite belonging to full 20-round chains (resume-fragment prefixes; repo_map section 2.2). Never use for chain length.",
      "enum": [3, 20]
    },
    "seed": { "type": "null", "description": "No seed exists in the run records (DECISIONS section 7)." },
    "timestamp": { "type": "string" },
    "change_description": { "type": "string" },
    "find_text": { "type": "string", "description": "Raw recorded FIND text, verbatim. Empty only on error records." },
    "replace_text": { "type": "string", "description": "Raw recorded REPLACE text — what apply_diff actually applied during replay." },
    "replace_text_sanitized": {
      "type": "string",
      "description": "export_changes.sanitize_replace_text output — the text the v1 grader saw (copied verbatim from the v1 coded file's changed_text where a v1 code exists). v2 grader input for comparability."
    },
    "is_abstention": { "type": "boolean" },
    "apply_status": {
      "type": "string",
      "enum": ["applied", "no_change", "find_not_found", "find_ambiguous", "generation_error"]
    },
    "match_strategy": {
      "type": ["string", "null"],
      "enum": ["exact", "whitespace", "fuzzy", "no_change", null],
      "description": "Recorded strategy for applied/abstention records; null on error records (whose stored 'exact' is a meaningless publish-time default)."
    },
    "retried": { "type": "boolean" },
    "error": { "type": ["string", "null"] },
    "generation_input_tokens": { "type": "integer", "minimum": 0 },
    "generation_output_tokens": { "type": "integer", "minimum": 0 },
    "section_heading": {
      "type": ["string", "null"],
      "description": "Nearest markdown heading at or above the matched span in the pre-application state ('' if none precedes it); null when context is missing."
    },
    "context_before": {
      "type": ["string", "null"],
      "description": "Full paragraph immediately preceding the paragraph containing the match span start ('' at document start); null when context is missing."
    },
    "context_after": {
      "type": ["string", "null"],
      "description": "Full paragraph immediately following the paragraph containing the match span end ('' at document end); null when context is missing."
    },
    "context_missing_reason": {
      "type": ["string", "null"],
      "enum": ["error_record_no_edit_text", "abstention_no_span", null]
    },
    "v1_code": {
      "type": ["object", "null"],
      "description": "The original Gemma v1 'coding' object, verbatim; null for the 158 errors and 2 abstentions v1 never coded."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "apply_status": { "const": "applied" } } },
      "then": {
        "properties": {
          "match_strategy": { "enum": ["exact", "whitespace", "fuzzy"] },
          "error": { "type": "null" },
          "is_abstention": { "const": false },
          "section_heading": { "type": "string" },
          "context_before": { "type": "string" },
          "context_after": { "type": "string" },
          "context_missing_reason": { "type": "null" },
          "v1_code": { "type": "object" },
          "find_text": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "apply_status": { "const": "no_change" } } },
      "then": {
        "properties": {
          "is_abstention": { "const": true },
          "match_strategy": { "const": "no_change" },
          "error": { "type": "null" },
          "v1_code": { "type": "null" },
          "context_missing_reason": { "const": "abstention_no_span" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "apply_status": { "enum": ["find_not_found", "find_ambiguous", "generation_error"] }
        }
      },
      "then": {
        "properties": {
          "error": { "type": "string", "minLength": 1 },
          "is_abstention": { "const": false },
          "match_strategy": { "type": "null" },
          "v1_code": { "type": "null" },
          "context_missing_reason": { "const": "error_record_no_edit_text" }
        }
      }
    }
  ]
}
