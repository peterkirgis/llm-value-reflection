.env
.envrc
__pycache__/
*.pyc
.venv/
# Run outputs are ignored by default, but the iterative-edit results are
# committed: the coded data is expensive to regenerate and was already lost
# once (results/iterative_edit/README.md tells that story).
results/*
!results/iterative_edit/
# per-run exports and v1-coder outputs written next to the run files
results/iterative_edit/*_changes.json
results/iterative_edit/*_judge_beneficiary_coded.json
data/processed/
docs/data/site.json
.ruff_cache/
*.egg-info/
dist/

# macOS
.DS_Store

# Scratch / exploratory
scratch/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Quarto build outputs (the archived midterm presentation)
archive/spar_midterm/presentation_files/
archive/spar_midterm/presentation.html
archive/spar_midterm/presentation.pdf

# The conference paper lives on the "paper" branch, not on main. Figure
# scripts may still render print-size copies into analysis/paper/; never
# commit them here.
analysis/paper/
